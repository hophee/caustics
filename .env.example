# Copy to .env (gitignored) and fill in. Generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=
KOMPAS_JWT_SECRET=
KOMPAS_INVITE_SECRET=

# OHLP drug base (~21 MB, in the repo root); set only to use another file
# KOMPAS_OHLP_HOST_PATH=/path/to/ohlp_fields_v4.csv

# Hugging Face hub cache with Qwen3-4B and opus-mt-ru-en (default: ~/.cache/huggingface/hub)
# HF_CACHE_HOST_PATH=
# KOMPAS_TEXT_MODEL=keywords   # skip the language model (no weights needed, low RAM)

# Where the site listens. 127.0.0.1 = this machine only; 0.0.0.0 = reachable from the network.
KOMPAS_WEB_BIND=127.0.0.1
KOMPAS_WEB_PORT=8080

# Image tag for the backend image (another stack on the same daemon can use a different tag)
# KOMPAS_IMAGE=kompas-backend

# «Попробовать как пациент / как врач» on the login page (throwaway synthetic accounts)
# KOMPAS_DEMO_MODE=true
