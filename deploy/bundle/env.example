# Copy to .env and fill in (./start.sh does this for you with random secrets).
# Secrets: any random 32+ characters, e.g. `openssl rand -hex 32`.
POSTGRES_PASSWORD=
KOMPAS_JWT_SECRET=
KOMPAS_INVITE_SECRET=

# The app image loaded from images/ (see images/IMAGE_TAG)
KOMPAS_IMAGE=kompas-backend:bundle

# Diary text model: keywords (no extra RAM) or llm (needs hf/hub weights and ~20 GB RAM)
KOMPAS_TEXT_MODEL=keywords

# Where the site listens: 127.0.0.1 = this computer only; 0.0.0.0 = also other computers on the network
KOMPAS_WEB_BIND=127.0.0.1
KOMPAS_WEB_PORT=8080

# Optional: other locations of the data
# KOMPAS_OHLP_HOST_PATH=./data/ohlp_fields_v4.csv
# HF_CACHE_HOST_PATH=./hf/hub

# Demo buttons on the login page («Попробовать как пациент / как врач»): true / false
KOMPAS_DEMO_MODE=true
